title = "Молния"
description = "Попадание перескакивает молнией на 3 врагов (0.5 У). Удар-приземление — разряд с неба по всем, кто под током."
description_lvl2 = "След на полу: земля под током вдоль полёта."
description_lvl3 = "Аура (Громоотвод): воткнутый молот раз в 1 с бьёт молнией в радиусе 4 м. Цепь — на 5 врагов."
description_lvl4 = "С неба (Гром небесный): идеальный хват — молния в точку прицела, оглушает. Громоотвод — раз в 0.6 с."
glyph = "ᛋ"
color = Color(1, 0.9, 0.35, 1)
group = "стихия"
max_level = 4
level_pool_ids = PackedStringArray("chain_lightning", "", "lightning_rod", "sky_thunder")
