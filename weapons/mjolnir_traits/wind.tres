[resource]
script = ExtResource("1_trait")
id = &"wind"
kind = "element"
title = "Ветер"
description = "Попадание сильно отбрасывает: сбивает с краёв и балконов, бросает о стены. Удар-приземление — вихрь, сносящий всех вокруг."
description_lvl2 = "След на полу: порывы ветра сдувают наступивших."
description_lvl3 = "Аура: воткнутый молот отталкивает всех вокруг."
description_lvl4 = "С неба: идеальный хват — смерч в точке прицела подбрасывает врагов."
glyph = "ᚹ"
color = Color(0.78, 0.95, 0.85, 1)
group = "стихия"
max_level = 4
handler = SubResource("Resource_handler")
