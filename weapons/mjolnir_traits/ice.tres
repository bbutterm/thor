[resource]
script = ExtResource("1_trait")
id = &"ice"
kind = "element"
title = "Лёд"
description = "Каждое попадание замедляет, на третьем враг замерзает. Удар-приземление по замёрзшему раскалывает: двойной урон и осколки в соседей."
description_lvl2 = "След на полу: полоса льда — враги скользят и падают."
description_lvl3 = "Аура: воткнутый молот промораживает всех вокруг. Падение на льду — стан 1 с."
description_lvl4 = "С неба: идеальный хват — ледяной шип в точку прицела, всё вокруг замерзает."
glyph = "ᛁ"
color = Color(0.55, 0.88, 1, 1)
group = "стихия"
max_level = 4
level_pool_ids = PackedStringArray("", "ice_trail", "", "")
handler = SubResource("Resource_handler")
