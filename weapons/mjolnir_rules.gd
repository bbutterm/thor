extends Resource
class_name MjolnirRules
## Правила трейтов Мьёльнира (GDD 10, блок Б4): сколько стихий и приёмов, как собирается выбор.
## Файл — weapons/mjolnir_rules.tres (Run.mjolnir_rules). Числа — TUNING.md.
## Где дают: мини-босс (выбор «стихия или приём», Game) и дверь «Наковальня Эйтри» (только стихия,
## RunMap: anvil_*); улучшение уровня — повтор карточки или «Обслуживание Мьёльнира» в ларьке.

## Сколько стихий одновременно (вопрос владельца 2 открыт; по умолчанию одна на забег)
@export_range(0, 3) var max_elements: int = 1
## Можно ли сменить стихию по ходу (новая стихия заменит старую с подтверждением). false — одна на весь забег
@export var element_swap: bool = false
## Сколько приёмов одновременно (вопрос владельца 1: один или два)
@export_range(0, 4) var max_techniques: int = 2
## Карточек в выборе
@export_range(1, 4) var offer_count: int = 3
## Выбор после мини-босса: если можно взять и стихию, и приём — в наборе обязательно есть оба вида
@export var mix_kinds: bool = true
## Дверь «Наковальня Эйтри» (выбор стихии или её нового уровня) — включена
@export var anvil_enabled: bool = true
## Связка появилась — карточка-объявление на экране (с), комикс-слово и реплика Одина
@export var combo_card_time: float = 3.2
