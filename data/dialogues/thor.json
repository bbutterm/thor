	"pools": {
		"reply_death": [
			{
				"lines": [
					{
						"speaker": "thor",
						"emotion": "embarrassed",
						"text": "Я просто разогревался.",
						"choices": [
							{
								"id": "snap",
								"label": "Огрызнуться",
								"text": "И вообще, драугры жульничали!",
								"lines": [
									{
										"speaker": "odin",
										"emotion": "angry",
										"text": "Драугры не жульничают. У них мозгов нет.",
										"id": "thor.reply_death.01_01_snap_01"
									}
								]
							},
							{
								"id": "agree",
								"label": "Согласиться",
								"text": "Ладно. Я был медленный.",
								"lines": [
									{
										"speaker": "odin",
										"emotion": "neutral",
										"text": "Признание — первый шаг. Второй — пробежка.",
										"id": "thor.reply_death.01_01_agree_01"
									}
								]
							}
						],
						"id": "thor.reply_death.01_01"
					}
				]
			},
			{
				"lines": [
					{
						"speaker": "thor",
						"emotion": "angry",
						"text": "Это тело было бракованное!",
						"choices": [
							{
								"id": "snap",
								"label": "Огрызнуться",
								"text": "У него колени скрипели!",
								"lines": [
									{
										"speaker": "odin",
										"emotion": "smug",
										"text": "Это твои колени скрипели. Дух — тоже скрипит.",
										"id": "thor.reply_death.02_01_snap_01"
									}
								]
							},
							{
								"id": "agree",
								"label": "Согласиться",
								"text": "Ну… может, это я бракованный.",
								"lines": [
									{
										"speaker": "odin",
										"emotion": "happy",
										"text": "Не бракованный. Неотремонтированный. Чиним.",
										"id": "thor.reply_death.02_01_agree_01"
									}
								]
							}
						],
						"id": "thor.reply_death.02_01"
					}
				]
			},
			{
				"lines": [
					{
						"speaker": "thor",
						"emotion": "embarrassed",
						"text": "Пап, можно я сегодня пропущу?",
						"choices": [
							{
								"id": "snap",
								"label": "Огрызнуться",
								"text": "У меня справка от Эйр!",
								"lines": [
									{
										"speaker": "odin",
										"emotion": "angry",
										"text": "Эйр лечит раны, а не лень. Справка порвана.",
										"id": "thor.reply_death.03_01_snap_01"
									}
								]
							},
							{
								"id": "agree",
								"label": "Согласиться",
								"text": "Понял. Не пропущу.",
								"lines": [
									{
										"speaker": "odin",
										"emotion": "neutral",
										"text": "Правильно понял. Встаём.",
										"id": "thor.reply_death.03_01_agree_01"
									}
								]
							}
						],
						"id": "thor.reply_death.03_01"
					}
				]
			},
			{
				"lines": [
					{
						"speaker": "thor",
						"emotion": "angry",
						"text": "Ты бы сам попробовал в этом теле!",
						"choices": [
							{
								"id": "snap",
								"label": "Огрызнуться",
								"text": "Да ты бы и до первого зала не дошёл!",
								"lines": [
									{
										"speaker": "odin",
										"emotion": "smug",
										"text": "Я тысячу лет бегаю по утрам. Хочешь — завтра со мной?",
										"id": "thor.reply_death.04_01_snap_01"
									},
									{
										"speaker": "thor",
										"emotion": "shocked",
										"text": "Нет-нет-нет. Я пошутил.",
										"id": "thor.reply_death.04_01_snap_02"
									}
								]
							},
							{
								"id": "agree",
								"label": "Согласиться",
								"text": "Хотя ты, наверное, и пробовал.",
								"lines": [
									{
										"speaker": "odin",
										"emotion": "happy",
										"text": "Пробовал. Прошёл без единой смерти. Завидуй молча.",
										"id": "thor.reply_death.04_01_agree_01"
									}
								]
							}
						],
						"id": "thor.reply_death.04_01"
					}
				]
			},
			{
				"lines": [
					{
						"speaker": "thor",
						"emotion": "embarrassed",
						"text": "Я почти его победил! Ещё бы чуть-чуть…",
						"choices": [
							{
								"id": "snap",
								"label": "Огрызнуться",
								"text": "Ты отвлёк меня своим свистком!",
								"lines": [
									{
										"speaker": "odin",
										"emotion": "angry",
										"text": "Я свистел ДО боя. Ты его просто запомнил.",
										"id": "thor.reply_death.05_01_snap_01"
									}
								]
							},
							{
								"id": "agree",
								"label": "Согласиться",
								"text": "Надо было уворачиваться.",
								"lines": [
									{
										"speaker": "odin",
										"emotion": "neutral",
										"text": "Вот. Рывок — твой друг. Дружи с ним.",
										"id": "thor.reply_death.05_01_agree_01"
									}
								]
							}
						],
						"id": "thor.reply_death.05_01"
					}
				]
			},
			{
				"lines": [
					{
						"speaker": "thor",
						"emotion": "angry",
						"text": "Ну всё, я обиделся. Иду на диван.",
						"choices": [
							{
								"id": "snap",
								"label": "Огрызнуться",
								"text": "Навсегда!",
								"lines": [
									{
										"speaker": "odin",
										"emotion": "smug",
										"text": "Ты и так на диване. Это называется «уже пришёл».",
										"id": "thor.reply_death.06_01_snap_01"
									},
									{
										"speaker": "thor",
										"emotion": "embarrassed",
										"text": "…Тогда обижаюсь стоя.",
										"id": "thor.reply_death.06_01_snap_02"
									}
								]
							},
							{
								"id": "agree",
								"label": "Согласиться",
								"text": "Ладно, на пять минут.",
								"lines": [
									{
										"speaker": "odin",
										"emotion": "neutral",
										"text": "Три. И одна из них уже прошла.",
										"id": "thor.reply_death.06_01_agree_01"
									}
								]
							}
						],
						"id": "thor.reply_death.06_01"
					}
				]
			}
		],
