				},
				{
					"speaker": "jarl",
					"emotion": "embarrassed",
					"text": "Это не нитка! Это… крепкий шов! Мне его пришили! Почти профессионально!",
					"id": "jarl_intro_03"
				},
				{
					"speaker": "jarl",
					"emotion": "angry",
					"text": "На колени перед ярлом Бьорном Мёртвым!",
					"choices": [
						{
							"id": "snap",
							"label": "Огрызнуться",
							"text": "Колени у меня и так болят!",
							"lines": [
								{
									"speaker": "jarl",
									"emotion": "smug",
									"text": "Значит, болеть будут ещё и уши! Ха-ха! Это была угроза!",
									"id": "jarl_intro_04_snap_01"
								}
							]
						},
						{
							"id": "agree",
							"label": "Согласиться",
							"text": "Ладно, можно я просто сяду?",
							"lines": [
								{
									"speaker": "jarl",
									"emotion": "shocked",
									"text": "…Сядь. Нет, стой! Это бой! Я запутался!",
									"id": "jarl_intro_04_agree_01"
								}
							]
						}
					],
					"id": "jarl_intro_04"
				},
				{
					"speaker": "odin",
					"emotion": "neutral",
					"text": "Его рука — бумеранг. Пока летит — уворачивайся. Без руки — бей.",
					"id": "jarl_intro_05"
				}
			]
		}
