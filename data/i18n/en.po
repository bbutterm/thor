#: ui/weapon_hud.gd:148
msgid "ПУСТО"
msgstr "EMPTY"

#: ui/weapon_hud.gd:151
msgid "ур. %d"
msgstr "lv. %d"

#: weapons/chest.gd:44
msgid "[E] Открыть сундук"
msgstr "[E] Open chest"

#: weapons/defs/axe.tres (description)
msgid "Комбо из 3 ударов, третий — рубящий сверху (×2.2). Рабочая лошадка викинга."
msgstr "A 3-hit combo, the third is an overhead chop (×2.2). The viking's workhorse."

#: weapons/defs/club.tres (description)
msgid "Медленная и тяжёлая: оглушает на 1.5 с и сильно отбрасывает — сбивай с краёв."
msgstr "Slow and heavy: stuns for 1.5 s and knocks back hard — knock them off ledges."

#: weapons/defs/club.tres (display_name)
msgid "Дубина"
msgstr "Club"

#: weapons/defs/crossbow.tres (description)
msgid "Медленный, мощный болт пробивает одного врага насквозь."
msgstr "A slow, powerful bolt that pierces one enemy clean through."

#: weapons/defs/crossbow.tres (display_name)
msgid "Арбалет"
msgstr "Crossbow"

#: weapons/defs/knife.tres (description)
msgid "Очень быстрый, ×3 в спину, бегаешь быстрее."
msgstr "Very fast, ×3 from behind, you run faster."

#: weapons/defs/knife.tres (display_name)
msgid "Нож"
msgstr "Knife"

#: weapons/defs/lute.tres (description)
msgid "Каждый удар — аккорд. Три подряд — враги танцуют (особенность — позже)."
msgstr "Every hit is a chord. Three in a row — enemies dance (perk — later)."

#: weapons/defs/lute.tres (display_name)
msgid "Лютня"
msgstr "Lute"

#: weapons/defs/nailgun.tres (description)
msgid "Гномья поделка: очередь гвоздей, прибивает корм к полу на 1 с."
msgstr "A dwarven gadget: a burst of nails, pins fodder to the floor for 1 s."

#: weapons/defs/nailgun.tres (display_name)
msgid "Гвоздомёт"
msgstr "Nailgun"

#: weapons/defs/pickaxe.tres (description)
msgid "Медленная. По оглушённым — ×2. Пробивает щит и броню элиты."
msgstr "Slow. ×2 against stunned enemies. Pierces shields and elite armor."

#: weapons/defs/pickaxe.tres (display_name)
msgid "Кирка"
msgstr "Pickaxe"

#: weapons/defs/pistol.tres (description)
msgid "Быстрый и точный. Хорош, чтобы добить."
msgstr "Fast and accurate. Good for finishing off."

#: weapons/defs/pistol.tres (display_name)
msgid "Пистолет"
msgstr "Pistol"

#: weapons/defs/rifle.tres (description)
msgid "Очередь, средний урон; отдача уводит прицел вверх."
msgstr "Full auto, medium damage; recoil pulls your aim up."

#: weapons/defs/rifle.tres (display_name)
msgid "Автомат"
msgstr "Assault Rifle"

#: weapons/defs/rocket_launcher.tres (description)
msgid "Взрыв 2 У по площади. Тора не ранит, но подбрасывает: рокет-джамп."
msgstr "A 2 dmg explosion over an area. Doesn't hurt Thor, but launches him: rocket jump."

#: weapons/defs/rocket_launcher.tres (display_name)
msgid "Ракетница"
msgstr "Rocket Launcher"

#: weapons/defs/scythe.tres (description)
msgid "Медленная, но режет дугой почти в 180°."
msgstr "Slow, but cuts in an almost 180° arc."

#: weapons/defs/scythe.tres (display_name)
msgid "Коса"
msgstr "Scythe"

#: weapons/defs/shotgun.tres (description)
msgid "Дробь вблизи, 2 выстрела и долгая перезарядка."
msgstr "Buckshot up close, 2 shots and a long reload."

#: weapons/defs/shotgun.tres (display_name)
msgid "Обрез"
msgstr "Sawed-Off"

#: weapons/defs/smg.tres (description)
msgid "Очередь; разброс растёт, пока держишь курок."
msgstr "Full auto; spread grows while you hold the trigger."

#: weapons/defs/smg.tres (display_name)
msgid "Пистолет-пулемёт"
msgstr "SMG"

#: weapons/defs/spear.tres (description)
msgid "Тычок на 3.5 м, задевает до трёх врагов в линию."
msgstr "A 3.5 m thrust, hits up to three enemies in a line."

#: weapons/defs/spear.tres (display_name)
msgid "Копьё"
msgstr "Spear"

#: weapons/defs/staff.tres (description)
msgid "Посох жреца. Каждый 3-й удар — искра огня (особенность — позже)."
msgstr "A priest's staff. Every 3rd hit — a spark of fire (perk — later)."

#: weapons/defs/staff.tres (display_name)
msgid "Посох"
msgstr "Staff"

#: weapons/defs/sword.tres (description)
msgid "Быстрый, комбо из 4 ударов. (Парирование — позже.)"
msgstr "Fast, a 4-hit combo. (Parrying — later.)"

#: weapons/defs/sword.tres (display_name)
msgid "Меч"
msgstr "Sword"

#: weapons/loot.gd:215
#: scripts/shader_warmup.gd:212
msgid "Элита"
msgstr "Elite"

#: weapons/mjolnir_traits/air_catch.tres (description)
msgid "Поимка молота в воздухе возвращает ещё одну руну Мьёльнира."
msgstr "Catching the hammer in the air restores one extra Mjolnir rune."

#: weapons/mjolnir_traits/air_catch.tres (description_lvl2)
msgid "Поимка возвращает ещё две руны и подбрасывает Тора."
msgstr "Catching restores two extra runes and lifts Thor into the air."

#: weapons/mjolnir_traits/air_catch.tres (title)
msgid "Перехват в воздухе"
msgstr "Air Catch"

#: weapons/mjolnir_traits/boomerang.tres (description)
msgid "Молот не втыкается: летит по дуге и возвращается сам, ПКМ не нужен. Бросок быстрее."
msgstr "The hammer doesn't stick: it flies in an arc and comes back on its own, no RMB needed. Faster throw."

#: weapons/mjolnir_traits/boomerang.tres (description_lvl2)
msgid "Две петли."
msgstr "Two loops."

#: weapons/mjolnir_traits/boomerang.tres (title)
msgid "Бумеранг"
msgstr "Boomerang"

#: weapons/mjolnir_traits/charge.gd:25
msgid "ЗАРЯД"
msgstr "CHARGE"

#: weapons/mjolnir_traits/charge.tres (description)
msgid "Держи ПКМ — бросок копит силу: до ×2.2 урона, дальше и быстрее. Полный заряд пробивает щиты и броню элиты."
msgstr "Hold RMB — the throw builds power: up to ×2.2 damage, flies farther and faster. A full charge pierces shields and elite armor."

#: weapons/mjolnir_traits/charge.tres (description_lvl2)
msgid "Заряжается быстрее, до ×2.6; полный заряд оглушает."
msgstr "Charges faster, up to ×2.6; a full charge stuns."

#: weapons/mjolnir_traits/charge.tres (group)
#: weapons/mjolnir_traits/sling.tres (group)
#: weapons/mjolnir_traits/storm.tres (group)
msgid "удержание ПКМ"
msgstr "hold RMB"

#: weapons/mjolnir_traits/charge.tres (title)
msgid "Заряд"
msgstr "Charge"

#: weapons/mjolnir_traits/combos/earth_dive.tres (description)
msgid "Удар пике оставляет кратер: весь корм в радиусе падает замертво, остальных прибивает к полу."
msgstr "The dive strike leaves a crater: all fodder in range drops dead, everyone else is pinned to the floor."

#: weapons/mjolnir_traits/combos/earth_dive.tres (title)
msgid "Кратер"
msgstr "Crater"

#: weapons/mjolnir_traits/combos/fire_tornado.tres (description)
msgid "Зависший молот Бури — огненный смерч: шире, тянет к себе всех и поджигает, под ним горит земля."
msgstr "Storm's hovering hammer becomes a fire tornado: wider, pulls everyone in and sets them ablaze, the ground burns beneath it."

#: weapons/mjolnir_traits/combos/fire_tornado.tres (title)
msgid "Огненный смерч"
msgstr "Fire Tornado"

#: weapons/mjolnir_traits/combos/ice_ricochet.tres (description)
msgid "Каждый отскок молота оставляет ледяную корку и промораживает всех вокруг."
msgstr "Every bounce of the hammer leaves an ice crust and chills everyone around."

#: weapons/mjolnir_traits/combos/ice_ricochet.tres (title)
msgid "Ледяной рикошет"
msgstr "Ice Ricochet"

#: weapons/mjolnir_traits/combos/lightning_magnet.tres (description)
msgid "Стянутых Магнитом бьёт цепной разряд, а при возврате молния прыгает от каждого."
msgstr "Enemies pulled in by Magnet get chain-shocked, and on recall lightning jumps from each of them."

#: weapons/mjolnir_traits/combos/lightning_magnet.tres (title)
msgid "Грозовой магнит"
msgstr "Storm Magnet"

#: weapons/mjolnir_traits/combos/wind_pull.tres (description)
msgid "Тор летит к молоту, сдувая всех с пути, а на прилёте вихрь сносит толпу вокруг."
msgstr "Thor flies to the hammer blowing everyone out of the way, and on arrival a whirlwind sweeps the crowd away."

#: weapons/mjolnir_traits/combos/wind_pull.tres (title)
msgid "Ураганный рывок"
msgstr "Hurricane Dash"

#: weapons/mjolnir_traits/earth.tres (description)
msgid "Попадание прибивает врага к полу и оглушает на 1.5 с. Удар-приземление рядом с прибитыми — вторая волна."
msgstr "A hit pins the enemy to the floor and stuns for 1.5 s. A ground slam near pinned enemies sends a second wave."

#: weapons/mjolnir_traits/earth.tres (description_lvl2)
msgid "След на полу: разлом — наступивший падает. Попадание оглушает всех в радиусе 2 м."
msgstr "Trail on the floor: a fissure — whoever steps in falls. A hit stuns everyone within 2 m."

#: weapons/mjolnir_traits/earth.tres (description_lvl3)
msgid "Аура (Землетрясение): воткнутый молот трясёт землю; удар-приземление в 5 м от него — волна у молота."
msgstr "Aura (Earthquake): the stuck hammer shakes the ground; a ground slam within 5 m of it sends a wave at the hammer."

#: weapons/mjolnir_traits/earth.tres (description_lvl4)
msgid "С неба: идеальный хват — глыба в точку прицела. Каждая волна — ещё и третья."
msgstr "From the sky: a perfect catch drops a boulder where you aim. Every wave gets a third one."

#: weapons/mjolnir_traits/earth.tres (title)
msgid "Земля"
msgstr "Earth"

#: weapons/mjolnir_traits/fire.tres (description)
msgid "Попадание поджигает: урон со временем, огонь перекидывается на соседей. Удар-приземление по горящим — вспышка вокруг каждого."
msgstr "A hit sets enemies on fire: damage over time, and the fire spreads to neighbours. A ground slam on burning enemies — a flare around each one."

#: weapons/mjolnir_traits/fire.tres (description_lvl2)
msgid "След на полу: молот в полёте оставляет полосу огня (3 с, 0.3 У/с)."
msgstr "Trail on the floor: the flying hammer leaves a strip of fire (3 s, 0.3 dmg/s)."

#: weapons/mjolnir_traits/fire.tres (description_lvl3)
msgid "Аура: воткнутый молот поджигает всех вокруг. Огненный след — 5 с и шире."
msgstr "Aura: the stuck hammer sets everyone around on fire. Fire trail — 5 s and wider."

#: weapons/mjolnir_traits/fire.tres (description_lvl4)
msgid "С неба: идеальный хват — огненный столб в точку прицела."
msgstr "From the sky: a perfect catch brings down a pillar of fire where you aim."

#: weapons/mjolnir_traits/fire.tres (title)
msgid "Огонь"
msgstr "Fire"

#: weapons/mjolnir_traits/hammer_dive.tres (description)
msgid "В воздухе брось молот вниз — Тор летит за ним и бьёт ударом-приземлением с бонусом высоты +4 м."
msgstr "Throw the hammer down while airborne — Thor follows it into a ground slam with a +4 m height bonus."

#: weapons/mjolnir_traits/hammer_dive.tres (description_lvl2)
msgid "Бонус высоты +7 м."
msgstr "Height bonus +7 m."

#: weapons/mjolnir_traits/hammer_dive.tres (title)
msgid "Пике молотом"
msgstr "Hammer Dive"

#: weapons/mjolnir_traits/hammer_step.tres (description)
msgid "Воткнутый в стену молот — ступенька: встань на него и прыгни — прыжок в 1.5 раза выше. Молот ждёт ПКМ 6 с."
msgstr "A hammer stuck in a wall is a step: stand on it and jump — 1.5× higher. The hammer waits for RMB for 6 s."

#: weapons/mjolnir_traits/hammer_step.tres (description_lvl2)
msgid "Прыжок в 1.85 раза выше, молот ждёт 10 с."
msgstr "Jump 1.85× higher, the hammer waits 10 s."

#: weapons/mjolnir_traits/hammer_step.tres (title)
msgid "Молот-ступенька"
msgstr "Hammer Step"

#: weapons/mjolnir_traits/ice.tres (description)
msgid "Каждое попадание замедляет, на третьем враг замерзает. Удар-приземление по замёрзшему раскалывает: двойной урон и осколки в соседей."
msgstr "Every hit slows, on the third the enemy freezes. A ground slam on a frozen enemy shatters it: double damage and shards into neighbours."

#: weapons/mjolnir_traits/ice.tres (description_lvl2)
msgid "След на полу: полоса льда — враги скользят и падают."
msgstr "Trail on the floor: a strip of ice — enemies slip and fall."

#: weapons/mjolnir_traits/ice.tres (description_lvl3)
msgid "Аура: воткнутый молот промораживает всех вокруг. Падение на льду — стан 1 с."
msgstr "Aura: the stuck hammer chills everyone around. Falling on ice — 1 s stun."

#: weapons/mjolnir_traits/ice.tres (description_lvl4)
msgid "С неба: идеальный хват — ледяной шип в точку прицела, всё вокруг замерзает."
msgstr "From the sky: a perfect catch drops an ice spike where you aim, everything around freezes."

#: weapons/mjolnir_traits/ice.tres (title)
msgid "Лёд"
msgstr "Ice"

#: weapons/mjolnir_traits/lightning.tres (description)
msgid "Попадание перескакивает молнией на 3 врагов (0.5 У). Удар-приземление — разряд с неба по всем, кто под током."
msgstr "A hit jumps as lightning to 3 enemies (0.5 dmg). A ground slam calls a discharge from the sky on everyone who is shocked."

#: weapons/mjolnir_traits/lightning.tres (description_lvl2)
msgid "След на полу: земля под током вдоль полёта."
msgstr "Trail on the floor: electrified ground along the flight path."

#: weapons/mjolnir_traits/lightning.tres (description_lvl3)
msgid "Аура (Громоотвод): воткнутый молот раз в 1 с бьёт молнией в радиусе 4 м. Цепь — на 5 врагов."
msgstr "Aura (Lightning Rod): the stuck hammer strikes with lightning within 4 m every 1 s. Chain — 5 enemies."

#: weapons/mjolnir_traits/lightning.tres (description_lvl4)
msgid "С неба (Гром небесный): идеальный хват — молния в точку прицела, оглушает. Громоотвод — раз в 0.6 с."
msgstr "From the sky (Thunder from Above): a perfect catch calls lightning where you aim, stuns. Lightning Rod — every 0.6 s."

#: weapons/mjolnir_traits/lightning.tres (title)
msgid "Молния"
msgstr "Lightning"

#: weapons/mjolnir_traits/loyal_dog.tres (description)
msgid "Воткнутый молот сам бьёт ближайшего врага раз в секунду (0.7 У) и ждёт ПКМ 6 с."
msgstr "The stuck hammer bites the nearest enemy once a second (0.7 dmg) and waits for RMB for 6 s."

#: weapons/mjolnir_traits/loyal_dog.tres (description_lvl2)
msgid "Кусает раз в 0.6 с, ждёт 9 с."
msgstr "Bites every 0.6 s, waits 9 s."

#: weapons/mjolnir_traits/loyal_dog.tres (title)
msgid "Верный пёс"
msgstr "Loyal Dog"

#: weapons/mjolnir_traits/magnet.tres (description)
msgid "Воткнутый молот стягивает врагов в радиусе 6 м, а по возврату раскидывает."
msgstr "A stuck hammer pulls in enemies within 6 m and scatters them on return."

#: weapons/mjolnir_traits/magnet.tres (description_lvl2)
msgid "Радиус 9 м."
msgstr "9 m radius."

#: weapons/mjolnir_traits/magnet.tres (title)
msgid "Магнит"
msgstr "Magnet"

#: weapons/mjolnir_traits/pull_to_hammer.tres (description)
msgid "ПКМ — не молот летит к тебе, а ты к нему, сбивая всех на пути (1 У). Метни в стену у края — и взлетай."
msgstr "RMB — instead of the hammer flying to you, you fly to it, knocking down everyone on the way (1 dmg). Throw it at a wall near a ledge — and take off."

#: weapons/mjolnir_traits/pull_to_hammer.tres (description_lvl2)
msgid "Прилёт — мини-удар-приземление."
msgstr "Arrival — a mini ground slam."

#: weapons/mjolnir_traits/pull_to_hammer.tres (group)
#: weapons/mjolnir_traits/swap.tres (group)
msgid "к молоту"
msgstr "to the hammer"

#: weapons/mjolnir_traits/pull_to_hammer.tres (title)
msgid "Притяжение к молоту"
msgstr "Pull to the Hammer"

#: weapons/mjolnir_traits/ricochet.tres (description)
msgid "Отскакивает от стен и врагов до 3 раз — сам ищет следующую цель."
msgstr "Bounces off walls and enemies up to 3 times — finds the next target on its own."

#: weapons/mjolnir_traits/ricochet.tres (description_lvl2)
msgid "5 раз."
msgstr "5 times."

#: weapons/mjolnir_traits/ricochet.tres (title)
msgid "Рикошет"
msgstr "Ricochet"

#: weapons/mjolnir_traits/sling.gd:25
msgid "ПРАЩА"
msgstr "SLING"

#: weapons/mjolnir_traits/sling.tres (description)
msgid "Держи ПКМ — молот крутится вокруг Тора и бьёт всех рядом. Отпустил — летит быстрее и пробивает щиты насквозь."
msgstr "Hold RMB — the hammer spins around Thor hitting everyone nearby. Release — it flies faster and pierces right through shields."

#: weapons/mjolnir_traits/sling.tres (description_lvl2)
msgid "Крутится до 6 с, бросок ×1.6 урона."
msgstr "Spins up to 6 s, the throw deals ×1.6 damage."

#: weapons/mjolnir_traits/sling.tres (title)
msgid "Праща"
msgstr "Sling"

#: weapons/mjolnir_traits/storm.tres (description)
msgid "Зажми ПКМ при броске — молот зависнет и будет крутиться 3 с, нанося урон по кругу."
msgstr "Hold RMB while throwing — the hammer hovers and spins for 3 s, dealing damage in a circle."

#: weapons/mjolnir_traits/storm.tres (description_lvl2)
msgid "5 с и тянет к себе корм."
msgstr "5 s, and it pulls in fodder."

#: weapons/mjolnir_traits/storm.tres (title)
msgid "Буря"
msgstr "Storm"

#: weapons/mjolnir_traits/swap.tres (description)
msgid "ПКМ по летящему молоту — Тор и молот меняются местами, молот летит к руке сквозь толпу."
msgstr "RMB on the flying hammer — Thor and the hammer swap places, and the hammer flies back to the hand through the crowd."

#: weapons/mjolnir_traits/swap.tres (description_lvl2)
msgid "В точке прибытия — волна, раскидывающая врагов."
msgstr "A shockwave at the arrival point scatters enemies."

#: weapons/mjolnir_traits/swap.tres (title)
msgid "Обмен"
msgstr "Swap"

#: weapons/mjolnir_traits/two_hammers.tres (description)
msgid "Бросок раздваивается веером, каждый молот — ×0.6 урона."
msgstr "The throw splits into a fan, each hammer deals ×0.6 damage."

#: weapons/mjolnir_traits/two_hammers.tres (description_lvl2)
msgid "Три молота."
msgstr "Three hammers."

#: weapons/mjolnir_traits/two_hammers.tres (title)
msgid "Два молота"
msgstr "Two Hammers"

#: weapons/mjolnir_traits/wind.tres (description)
msgid "Попадание сильно отбрасывает: сбивает с краёв и балконов, бросает о стены. Удар-приземление — вихрь, сносящий всех вокруг."
msgstr "A hit knocks enemies far back: off ledges and balconies, into walls. A ground slam — a whirlwind that sweeps everyone away."

#: weapons/mjolnir_traits/wind.tres (description_lvl2)
msgid "След на полу: порывы ветра сдувают наступивших."
msgstr "Trail on the floor: gusts of wind blow away whoever steps in."

#: weapons/mjolnir_traits/wind.tres (description_lvl3)
msgid "Аура: воткнутый молот отталкивает всех вокруг."
msgstr "Aura: the stuck hammer pushes everyone around away."

#: weapons/mjolnir_traits/wind.tres (description_lvl4)
msgid "С неба: идеальный хват — смерч в точке прицела подбрасывает врагов."
msgstr "From the sky: a perfect catch spawns a tornado where you aim, tossing enemies up."

#: weapons/mjolnir_traits/wind.tres (title)
msgid "Ветер"
msgstr "Wind"

#: weapons/pickup.gd:77
msgid "мили"
msgstr "melee"

#: weapons/pickup.gd:77
msgid "ренж"
msgstr "ranged"

#: weapons/pickup.gd:79
msgid "[E] Взять: %s (%s, ур. %d)"
msgstr "[E] Take: %s (%s, lv. %d)"

#: weapons/pickup.gd:81
msgid "[E] Забрать патроны: %s"
msgstr "[E] Take ammo: %s"

#: weapons/pickup.gd:83
msgid " — бросить %s"
msgstr " — drop %s"

#: weapons/weapon_def.gd:10
#: weapons/defs/axe.tres (display_name)
msgid "Топор"
msgstr "Axe"

# --- Ключи, которых не нашёл сборщик (динамические строки или устаревшие; --prune удалит) ---

msgid "Быстрый и хрупкий. Три заряда рывка."
msgstr "Fast and fragile. Three dash charges."

msgid "+1 заряд рывка"
msgstr "+1 dash charge"

msgid "+1 заряд рывка всем телам. Встал в шесть. Сам."
msgstr "+1 dash charge for every body. Got up at six. By himself."

msgid "+2 заряда рывка"
msgstr "+2 dash charges"

msgid "+2 заряда, перезарядка быстрее"
msgstr "+2 charges, faster recharge"

msgid "Поймал молот в прыжке — снова есть двойной прыжок и заряд рывка: можно долго не касаться земли."
msgstr "Catch the hammer mid-air — your double jump and a dash charge come back: stay off the ground for ages."

msgid "Возвращаются все рывки, и Тора подбрасывает."
msgstr "All dash charges come back, and Thor gets a little hop."

msgid "Трейт «Бумеранг» в пул: молот возвращается сам."
msgstr "“Boomerang” trait into the pool: the hammer comes back on its own."

msgid "Трейт «Землетрясение» в пул: вторая волна у молота."
msgstr "“Earthquake” trait into the pool: a second shockwave at the hammer."

msgid "Трейт «Тяжесть» в пул: прибивает врага к земле."
msgstr "“Heaviness” trait into the pool: pins an enemy to the ground."

msgid "Трейт «Ледяной след» в пул: враги скользят и падают."
msgstr "“Ice Trail” trait into the pool: enemies slip and fall."

msgid "Трейт «Громоотвод» в пул: воткнутый молот бьёт молнией."
msgstr "“Lightning Rod” trait into the pool: a stuck hammer strikes with lightning."

msgid "Трейт «Гром небесный» в пул: идеальный хват зовёт молнию."
msgstr "“Sky Thunder” trait into the pool: a perfect catch calls down lightning."

msgid "Трейт «Буря» в пул: молот зависает и крутится."
msgstr "“Storm” trait into the pool: the hammer hovers and spins."

msgid "Трейт «Два молота» в пул: бросок раздваивается."
msgstr "“Two Hammers” trait into the pool: the throw splits in two."

msgid "Мьёльнир"
msgstr "Mjolnir"

msgid "уровень 2"
msgstr "level 2"

msgid "группа: %s"
msgstr "group: %s"

msgid "Трейт молота меняет то, как ты им играешь. Кликни или нажми 1 / 2 / 3"
msgstr "A hammer trait changes how you play with it. Click or press 1 / 2 / 3"

msgid "возврат"
msgstr "return"

msgid "При попадании молния прыгает на 3 ближайших врагов (0.5 У)."
msgstr "On hit, lightning jumps to the 3 nearest enemies (0.5 dmg)."

msgid "5 врагов."
msgstr "5 enemies."

msgid "попадание"
msgstr "hit"

msgid "Цепная молния"
msgstr "Chain Lightning"

msgid "Удар-приземление в 5 м от воткнутого молота даёт вторую ударную волну у молота."
msgstr "A ground slam within 5 m of the stuck hammer makes a second shockwave at the hammer."

msgid "Третья волна, шире."
msgstr "A third wave, wider."

msgid "Землетрясение"
msgstr "Earthquake"

msgid "Молот в полёте оставляет на полу полосу огня (3 с, 0.3 У/с)."
msgstr "The flying hammer leaves a strip of fire on the floor (3 s, 0.3 dmg/s)."

msgid "Огонь горит 5 с и шире."
msgstr "Fire burns for 5 s and wider."

msgid "след"
msgstr "trail"

msgid "Огненный след"
msgstr "Fire Trail"

msgid "Попадание прибивает врага к земле на 1.5 с."
msgstr "A hit pins the enemy to the ground for 1.5 s."

msgid "Оглушает всех в радиусе 2 м."
msgstr "Stuns everyone within 2 m."

msgid "Тяжесть"
msgstr "Heaviness"

msgid "Молот в полёте оставляет на полу полосу льда: враги скользят и падают."
msgstr "The flying hammer leaves a strip of ice on the floor: enemies slip and fall."

msgid "Падение — стан 1 с."
msgstr "A fall — 1 s stun."

msgid "Ледяной след"
msgstr "Ice Trail"

msgid "Воткнутый молот раз в секунду бьёт молнией всех в радиусе 4 м, пока не позовёшь."
msgstr "A stuck hammer strikes everyone within 4 m with lightning once a second until you recall it."

msgid "Раз в 0.6 с."
msgstr "Once every 0.6 s."

msgid "воткнулся"
msgstr "stuck"

msgid "Громоотвод"
msgstr "Lightning Rod"

msgid "Идеальный хват вызывает удар молнии с неба в точку прицела (1.5 У)."
msgstr "A perfect catch calls a lightning strike from the sky at your aim point (1.5 dmg)."

msgid "Ещё и оглушает."
msgstr "It stuns, too."

msgid "Гром небесный"
msgstr "Sky Thunder"

msgid "бросок"
msgstr "throw"

msgid "Нож в пул: ×3 в спину. Мама не заметит."
msgstr "Knife into the pool: ×3 from behind. Mom won't notice."

msgid "Нож с кухни"
msgstr "A Kitchen Knife"

msgid "Кирка в пул: плевать на щиты и броню."
msgstr "Pickaxe into the pool: shields and armor don't matter."

msgid "Спросил у гномов кирку"
msgstr "Asked the Dwarves for a Pickaxe"

msgid "Коса в пул: дуга 180°, корм ложится рядами."
msgstr "Scythe into the pool: a 180° arc, fodder falls in rows."

msgid "Нашёл косу в сарае"
msgstr "Found a Scythe in the Shed"

msgid "Копьё в пул: тычок на 3.5 м, пробивает двоих."
msgstr "Spear into the pool: a 3.5 m thrust, pierces two."

msgid "Почитал о копьях"
msgstr "Read Up on Spears"

msgid "Журнал [Tab / View]"
msgstr "Log [Tab / View]"

msgid "Пропустить [Y] ▸▸"
msgstr "Skip [Y] ▸▸"

msgid "Выбери руну: мышь, 1 / 2 / 3 или геймпад"
msgstr "Choose a rune: mouse, 1 / 2 / 3 or gamepad"

msgid "Клавиатура и геймпад переназначаются на вкладке «Клавиши»."
msgstr "Rebind keyboard and gamepad controls in the Keys tab."

msgid "УПРАВЛЕНИЕ — выбери столбец и нажми новую кнопку"
msgstr "CONTROLS — select a column and press a new button"

msgid "Слева клавиатура и мышь, справа геймпад. Esc или Start — отмена."
msgstr "Keyboard and mouse on the left, gamepad on the right. Esc or Start cancels."

msgid "Сбросить геймпад"
msgstr "Reset gamepad"

msgid "Геймпад — как по умолчанию."
msgstr "Gamepad reset to defaults."

msgid "Esc и Start — пауза; стрелки и A/B — навигация в меню."
msgstr "Esc and Start pause; arrows and A/B navigate menus."

msgid "нажми кнопку…"
msgstr "press a button…"

msgid "Esc или Start — отмена."
msgstr "Esc or Start cancels."

msgid "Уйти  [E / Esc / B]"
msgstr "Leave  [E / Esc / B]"

msgid "Камера влево"
msgstr "Camera left"

msgid "Камера вправо"
msgstr "Camera right"

msgid "Камера вверх"
msgstr "Camera up"

msgid "Камера вниз"
msgstr "Camera down"

msgid "Кнопка %d"
msgstr "Button %d"

msgid "Ось %d %s"
msgstr "Axis %d %s"

msgid "%s — сменить · %s — перезарядка"
msgstr "%s — switch · %s — reload"

msgid "Стихия — чем бьёт молот, приём — как ты им играешь. Мышь, 1 / 2 / 3 или геймпад"
msgstr "Element is how the hammer strikes, technique is how you play. Mouse, 1 / 2 / 3 or gamepad"

msgid "Геймпад: управление и кнопки — в настройках."
msgstr "Gamepad: controls and buttons are in Settings."

msgid "Правый стик — прокрутка описания."
msgstr "Right stick scrolls the description."

msgid "Правый стик — прокрутка журнала."
msgstr "Right stick scrolls the log."
