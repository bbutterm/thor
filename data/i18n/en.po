msgid "Согласиться"
msgstr "Agree"

#: enemies/bosses/jarl.gd:77
msgid "ЯРЛ БЬОРН МЁРТВЫЙ"
msgstr "JARL BJORN THE DEAD"

#: enemies/defs/bloated.tres (description)
msgid "Бежит и взрывается: 2 У в радиусе 3 м, бьёт и своих"
msgstr "Runs at you and explodes: 2 dmg in a 3 m radius, hits its own too"

#: enemies/defs/bloated.tres (title)
msgid "Раздутый"
msgstr "Bloated"

#: enemies/defs/draugr_fodder.tres (description)
msgid "Толпой, слабый удар, мычит"
msgstr "Comes in crowds, weak hit, moans"

#: enemies/defs/draugr_fodder.tres (title)
msgid "Драугр-корм"
msgstr "Draugr Fodder"

#: enemies/defs/draugr_warrior.tres (description)
msgid "Замах 0.6 с с подсветкой, у 30% щит"
msgstr "0.6 s highlighted windup, 30% carry a shield"

#: enemies/defs/draugr_warrior.tres (title)
msgid "Драугр-воин"
msgstr "Draugr Warrior"

#: enemies/defs/fallen_valkyrie.tres (description)
msgid "Пикирует сверху"
msgstr "Dives from above"

#: enemies/defs/fallen_valkyrie.tres (title)
msgid "Падшая валькирия"
msgstr "Fallen Valkyrie"

#: enemies/defs/frost_spirit.tres (description)
msgid "Летает сквозь стены, касание замедляет"
msgstr "Flies through walls, its touch slows you"

#: enemies/defs/frost_spirit.tres (title)
msgid "Морозный дух"
msgstr "Frost Spirit"

#: enemies/defs/ghost.tres (description)
msgid "Виден, только пока атакует"
msgstr "Only visible while attacking"

#: enemies/defs/ghost.tres (title)
msgid "Призрак"
msgstr "Ghost"

#: enemies/defs/hrimthurs.tres (description)
msgid "Великан: волна по земле, кидает глыбы (сейчас — босс-заглушка)"
msgstr "Giant: ground wave, hurls boulders (placeholder boss for now)"

#: enemies/defs/hrimthurs.tres (title)
msgid "Хримтурс"
msgstr "Hrimthurs"

#: enemies/defs/ice_fodder.tres (description)
msgid "При смерти оставляет лёд"
msgstr "Leaves ice when it dies"

#: enemies/defs/ice_fodder.tres (title)
msgid "Ледяной корм"
msgstr "Ice Fodder"

#: enemies/defs/ice_shieldbearer.tres (description)
msgid "Щит изо льда, ломается ударом-приземлением"
msgstr "Ice shield, breaks under a ground slam"

#: enemies/defs/ice_shieldbearer.tres (title)
msgid "Ледяной щитоносец"
msgstr "Ice Shieldbearer"

#: enemies/defs/icicle_thrower.tres (description)
msgid "Сосулька замедляет на 2 с"
msgstr "Icicle slows you for 2 s"

#: enemies/defs/icicle_thrower.tres (title)
msgid "Метатель сосулек"
msgstr "Icicle Thrower"

#: enemies/defs/jarl.tres (description)
msgid "Босс Мидгарда (GDD 14.2): рука-бумеранг, балконы и корм, ломает балконы и бодается. Слава за босса — Run.glory_boss_kill (150)"
msgstr "Midgard boss (GDD 14.2): boomerang arm, balconies and fodder, breaks balconies and headbutts. Boss Glory — Run.glory_boss_kill (150)"

#: enemies/defs/jarl.tres (title)
msgid "Ярл Бьорн Мёртвый"
msgstr "Jarl Bjorn the Dead"

#: enemies/defs/loki_merc.tres (description)
msgid "Автомат, лазерная точка 0.8 с перед очередью, роняет патроны"
msgstr "Assault rifle, laser dot 0.8 s before a burst, drops ammo"

#: enemies/defs/loki_merc.tres (title)
msgid "Наёмник Локи"
msgstr "Loki's Mercenary"

#: enemies/defs/mourner.tres (description)
msgid "Крик глушит экран и музыку на 3 с"
msgstr "Her scream muffles the screen and music for 3 s"

#: enemies/defs/mourner.tres (title)
msgid "Плакальщица"
msgstr "Mourner"

#: enemies/defs/nidhogg_worm.tres (description)
msgid "Вырывается из-под земли"
msgstr "Bursts out of the ground"

#: enemies/defs/nidhogg_worm.tres (title)
msgid "Червь Нидхёгга"
msgstr "Nidhogg Worm"

#: enemies/defs/shaman.tres (description)
msgid "На высоте; лечит и поднимает корм раз в 6 с"
msgstr "Up high; heals and raises fodder every 6 s"

#: enemies/defs/shaman.tres (title)
msgid "Шаман"
msgstr "Shaman"

#: enemies/defs/shieldbearer.tres (description)
msgid "Щит спереди блокирует всё, теснит к краю"
msgstr "Front shield blocks everything, pushes you to the edge"

#: enemies/defs/shieldbearer.tres (title)
msgid "Щитоносец"
msgstr "Shieldbearer"

#: enemies/defs/skeleton.tres (description)
msgid "Собирается снова через 3 с"
msgstr "Pulls itself together again after 3 s"

#: enemies/defs/skeleton.tres (title)
msgid "Скелет"
msgstr "Skeleton"

#: enemies/defs/snow_wolf.tres (description)
msgid "Стаи по 3–4, прыжок-укус, обходят с флангов"
msgstr "Packs of 3–4, leap-bite, flank you"

#: enemies/defs/snow_wolf.tres (title)
msgid "Снежный волк"
msgstr "Snow Wolf"

#: enemies/defs/thrower.tres (description)
msgid "Держит 8–12 м, кидает топоры, лезет на балконы"
msgstr "Keeps 8–12 m away, throws axes, climbs balconies"

#: enemies/defs/thrower.tres (title)
msgid "Метатель"
msgstr "Thrower"

#: enemies/elite/armored.gd:39
msgid " — сломана"
msgstr " — broken"

#: enemies/elite/mods/armored.tres (title)
msgid "Бронированный"
msgstr "Armored"

#: enemies/elite/mods/explosive.tres (title)
msgid "Взрывной"
msgstr "Explosive"

#: enemies/elite/mods/fast.tres (title)
msgid "Быстрый"
msgstr "Fast"

#: enemies/elite/mods/fire.tres (title)
msgid "Огненный"
msgstr "Fiery"

#: enemies/elite/mods/ice.tres (title)
msgid "Ледяной"
msgstr "Icy"

#: enemies/elite/mods/summoner.tres (title)
msgid "Призыватель"
msgstr "Summoner"

#: enemies/elite/mods/vampire.tres (title)
msgid "Вампир"
msgstr "Vampire"

#: enemies/miniboss_def.gd:11
msgid "ТОЛСТЫЙ СВЕН"
msgstr "FAT SVEN"

#: player/movement_profile.gd:9
#: run/movement/base.tres (title)
msgid "Базовый"
msgstr "Basic"

#: player/style_meter.gd:27
msgid "ДОСТОЙНЕЙШИЙ!"
msgstr "MOST WORTHY!"

